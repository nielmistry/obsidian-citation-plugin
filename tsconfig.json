{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2022",
    "noImplicitAny": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "moduleResolution": "bundler",
    "importHelpers": true,
    "lib": [
      "DOM",
      "ES2022"
    ]
  },
  "include": [
    "**/*.ts"
  ]
}
